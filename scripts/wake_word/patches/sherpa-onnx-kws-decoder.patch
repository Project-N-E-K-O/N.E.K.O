+// KWS-only alignment bookkeeping and candidate acceptance.
+// Shared ASR Hypotheses::Add intentionally remains unchanged.
+#ifndef SHERPA_ONNX_CSRC_NEKO_KWS_DECODER_H_
+#define SHERPA_ONNX_CSRC_NEKO_KWS_DECODER_H_
+
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+#include <tuple>
+#include <unordered_map>
+#include <utility>
+
+#include "sherpa-onnx/csrc/hypothesis.h"
+
+namespace sherpa_onnx {
+namespace neko_kws {
+
+using PathScores = std::unordered_map<std::string, double>;
+
+// Used only at a genuine empty-stream / accepted-keyword initialization.
+inline void Initialize(Hypotheses *hyps, PathScores *scores,
+                       const std::vector<int64_t> &blanks,
+                       const ContextState *root = nullptr) {
+  Hypothesis h(blanks, 0, root);
+  scores->clear();
+  scores->emplace(h.Key(), 0.0);
+  *hyps = Hypotheses({std::move(h)});
+}
+
+inline double PathScore(const PathScores &scores, const Hypothesis &h) {
+  auto it = scores.find(h.Key());
+  if (it == scores.end()) {
+    throw std::logic_error("KWS alignment score missing for active hypothesis");
+  }
+  if (std::isnan(it->second) || it->second == INFINITY) {
+    throw std::logic_error("KWS invalid alignment score");
+  }
+  return it->second;
+}
+
+inline void ValidateScores(const Hypotheses &hyps, const PathScores &scores) {
+  if (hyps.Size() != scores.size()) {
+    throw std::logic_error("KWS hypotheses and alignment scores out of sync");
+  }
+  for (const auto &entry : hyps) PathScore(scores, entry.second);
+}
+
+// Equal-score paths use metadata order, never unordered_map iteration order.
+// Equal token sequences in one deterministic context graph share context state.
+inline bool EarlierMetadata(const Hypothesis &a, const Hypothesis &b) {
+  return std::tie(a.timestamps, a.ys_probs, a.num_trailing_blanks) <
+         std::tie(b.timestamps, b.ys_probs, b.num_trailing_blanks);
+}
+
+inline void Add(std::unordered_map<std::string, Hypothesis> *hyps,
+                PathScores *scores, Hypothesis h, double path_score) {
+  if (std::isnan(path_score) || path_score == INFINITY ||
+      std::isnan(h.log_prob) || h.log_prob == INFINITY) {
+    throw std::logic_error("KWS invalid merge score");
+  }
+  const auto key = h.Key();
+  auto it = hyps->find(key);
+  if (it == hyps->end()) {
+    hyps->emplace(key, std::move(h));
+    if (!scores->emplace(key, path_score).second) {
+      throw std::logic_error("KWS orphan alignment score");
+    }
+    return;
+  }
+  const double old_path_score = PathScore(*scores, it->second);
+  const double total = LogAdd<double>()(it->second.log_prob, h.log_prob);
+  if (path_score > old_path_score ||
+      (path_score == old_path_score && EarlierMetadata(h, it->second))) {
+    it->second = std::move(h);
+    scores->at(key) = path_score;
+  }
+  it->second.log_prob = total;
+}
+
+inline const ContextState *Eligible(const Hypothesis &h,
+                                    const ContextGraph &graph,
+                                    int32_t required_blanks) {
+  if (!h.context_state || !std::isfinite(h.log_prob)) return nullptr;
+  const auto status = graph.IsMatched(h.context_state);
+  const auto *state = status.second;
+  if (!status.first || !state || state->level <= 0 ||
+      h.num_trailing_blanks <= required_blanks) return nullptr;
+  const auto n = static_cast<size_t>(state->level);
+  if (h.ys.size() < n || h.ys_probs.size() < n || h.timestamps.size() < n ||
+      !std::isfinite(state->ac_threshold)) return nullptr;
+  float mean = 0;
+  // Preserve upstream prefix probability indexing in this change.
+  for (size_t i = 0; i < n; ++i) {
+    if (!std::isfinite(h.ys_probs[i]) || h.ys_probs[i] < 0 ||
+        h.ys_probs[i] > 1) return nullptr;
+    mean += h.ys_probs[i];
+  }
+  auto first = h.timestamps.end() - n;
+  if (*first < 0 || !std::is_sorted(first, h.timestamps.end())) return nullptr;
+  return mean / n >= state->ac_threshold ? state : nullptr;
+}
+
+struct Match {
+  const Hypothesis *hypothesis = nullptr;
+  const ContextState *state = nullptr;
+};
+
+inline Match Select(const Hypotheses &hyps, const ContextGraph &graph,
+                    int32_t required_blanks, bool all_candidates) {
+  Match best;
+  if (!all_candidates) {
+    // Preserve upstream ranking/tie behavior in the ablation baseline.
+    const auto top = hyps.GetMostProbable(false);
+    for (const auto &entry : hyps) {
+      if (entry.first == top.Key()) {
+        const auto *state = Eligible(entry.second, graph, required_blanks);
+        return {state ? &entry.second : nullptr, state};
+      }
+    }
+    return best;
+  }
+  for (const auto &entry : hyps) {
+    const auto &h = entry.second;
+    auto *state = Eligible(h, graph, required_blanks);
+    if (state && (!best.hypothesis ||
+        h.log_prob > best.hypothesis->log_prob ||
+        (h.log_prob == best.hypothesis->log_prob &&
+         h.ys < best.hypothesis->ys))) {
+      best = {&h, state};
+    }
+  }
+  return best;
+}
+
+}  // namespace neko_kws
+}  // namespace sherpa_onnx
+#endif  // SHERPA_ONNX_CSRC_NEKO_KWS_DECODER_H_
