+
+using namespace sherpa_onnx;  // NOLINT
+using nlohmann::json;
+
+void Require(bool value, const char *message) {
+  if (!value) throw std::runtime_error(message);
+}
+
+struct Input {
+  std::string name;
+  std::vector<float> pcm;
+  std::vector<std::pair<float, float>> calls;
+};
+
+void Append(Input *input, const std::vector<float> &pcm, float silence) {
+  input->pcm.resize(input->pcm.size() + static_cast<size_t>(16000 * silence));
+  float start = input->pcm.size() / 16000.f;
+  input->pcm.insert(input->pcm.end(), pcm.begin(), pcm.end());
+  input->calls.push_back({start, input->pcm.size() / 16000.f});
+}
+
+struct Live {
+  std::unique_ptr<OnlineStream> stream;
+  size_t offset = 0;
+  std::vector<KeywordResult> hits;
+  int reset_conditions = 0;
+  int confirmed_silence_resets = 0;
+  int explicit_resets = 0;
+  int max_hyps = 0;
+};
+
+json Run(KeywordSpotter *spotter, const std::vector<Input> &inputs, bool batch,
+         bool explicit_reset, const std::vector<size_t> &chunks) {
+  std::vector<Live> streams(inputs.size());
+  for (auto &s : streams) s.stream = spotter->CreateStream();
+  int batch_two_calls = 0;
+  for (;;) {
+    bool fed = false;
+    for (size_t i = 0; i < streams.size(); ++i) {
+      auto &s = streams[i];
+      size_t count = std::min(chunks[i], inputs[i].pcm.size() - s.offset);
+      if (count) {
+        s.stream->AcceptWaveform(16000, inputs[i].pcm.data() + s.offset, count);
+        s.offset += count;
+        fed = true;
+      }
+    }
+    for (;;) {
+      std::vector<OnlineStream *> ready;
+      std::vector<size_t> indices;
+      std::vector<int> old_frames;
+      std::vector<bool> silence_reset_expected;
+      for (size_t i = 0; i < streams.size(); ++i) {
+        auto &s = streams[i];
+        if (spotter->IsReady(s.stream.get())) {
+          ready.push_back(s.stream.get()); indices.push_back(i);
+          auto &r = s.stream->GetKeywordResult(false);
+          old_frames.push_back(r.frame_offset);
+          silence_reset_expected.push_back(explicit_reset && r.num_trailing_blanks * 0.04f > 1.5f);
+          // This is the condition used by native automatic silence Reset.
+          if (r.num_trailing_blanks * 0.04f > 1.5f) ++s.reset_conditions;
+          if (!batch) break;
+        }
+      }
+      if (ready.empty()) break;
+      if (ready.size() == 2) ++batch_two_calls;
+      spotter->DecodeStreams(ready.data(), ready.size());
+      for (size_t j = 0; j < ready.size(); ++j) {
+        auto &s = streams[indices[j]];
+        auto &state = s.stream->GetKeywordResult(false);
+        Require(state.frame_offset > old_frames[j], "frame clock failed across decode/reset");
+        if (silence_reset_expected[j]) {
+          Require(state.num_trailing_blanks <= state.frame_offset - old_frames[j],
+                  "silence reset did not clear old trailing blank state");
+          ++s.confirmed_silence_resets;
+        }
+        neko_kws::ValidateScores(state.hyps, state.alignment_scores);
+        Require(state.hyps.Size() <= 8 && state.hyps.Size() > 0, "beam storage unbounded");
+        s.max_hyps = std::max(s.max_hyps, state.hyps.Size());
+        auto result = spotter->GetResult(s.stream.get());  // exactly one consuming read
+        if (!result.keyword.empty()) {
+          Require(!result.timestamps.empty(), "hit has no timestamps");
+          Require(std::is_sorted(result.timestamps.begin(), result.timestamps.end()),
+                  "hit timestamps not monotonic");
+          if (!s.hits.empty()) Require(result.timestamps.front() > s.hits.back().timestamps.back(),
+                                       "repeated hit overlaps prior keyword");
+          s.hits.push_back(result);
+          if (explicit_reset) {
+            int clock = state.frame_offset;
+            spotter->Reset(s.stream.get());
+            auto &empty = s.stream->GetKeywordResult(false);
+            Require(empty.frame_offset == clock, "explicit reset lost cumulative clock");
+            Require(empty.hyps.Size() == 1 && empty.alignment_scores.size() == 1,
+                    "explicit reset retained old candidates");
+            Require(empty.alignment_scores.begin()->second == 0,
+                    "explicit reset failed to reseed empty alignment");
+            ++s.explicit_resets;
+          }
+        }
+      }
+    }
+    if (!fed) break;
+  }
+  json rows = json::array();
+  for (size_t i = 0; i < streams.size(); ++i) {
+    auto &s = streams[i];
+    std::vector<int> counts(inputs[i].calls.size());
+    json hits = json::array();
+    for (const auto &h : s.hits) {
+      int matched = -1;
+      for (size_t k = 0; k < inputs[i].calls.size(); ++k) {
+        const auto &interval = inputs[i].calls[k];
+        if (h.timestamps.front() >= interval.first && h.timestamps.back() <= interval.second) {
+          Require(matched == -1, "hit maps to two calls"); matched = k;
+        }
+      }
+      Require(matched >= 0, "hit outside original utterance interval");
+      ++counts[matched];
+      hits.push_back(json::parse(h.AsJsonString()));
+    }
+    for (auto count : counts) Require(count == 1, "call missed or duplicated");
+    rows.push_back({{"name", inputs[i].name}, {"duration", inputs[i].pcm.size()/16000.0},
+                    {"calls", inputs[i].calls}, {"hits", hits},
+                    {"trailing_blank_condition_observations", s.reset_conditions},
+                    {"confirmed_silence_resets", s.confirmed_silence_resets},
+                    {"explicit_resets", s.explicit_resets}, {"max_hypotheses", s.max_hyps}});
+  }
+  if (batch && inputs.size() == 2) Require(batch_two_calls > 0, "no actual batch-two decode");
+  return {{"batch", batch}, {"explicit_reset", explicit_reset},
+          {"chunks", chunks}, {"batch_two_decode_calls", batch_two_calls}, {"streams", rows}};
+}
+
+int main(int argc, char **argv) {
+  try {
+    ParseOptions options(
+        "Native KWS lifecycle regression. Supply the same model flags as "
+        "sherpa-onnx-keyword-spotter followed by three positive PCM16 mono "
+        "16kHz WAVs: NAME.wav COMMAND.wav ACCEPTED_NEAR.wav. Requires a "
+        "combined-fix library and --max-active-paths=8. The WAVs must include "
+        "their natural recorded endings; this harness adds no tail padding.");
+    KeywordSpotterConfig config;
+    config.Register(&options);
+    options.Read(argc, argv);
+    Require(config.Validate(), "invalid config");
+    Require(config.max_active_paths == 8, "lifecycle fixture contract requires paths=8");
+    KeywordSpotter spotter(config);
+    std::vector<std::vector<float>> clips;
+    for (int i = 1; i <= options.NumArgs(); ++i) {
+      int rate = 0; bool ok = false;
+      clips.push_back(ReadWave(options.GetArg(i), &rate, &ok));
+      Require(ok && rate == 16000, "invalid input wave");
+    }
+    Require(clips.size() == 3, "need name command near WAVs");
+    json runs = json::array();
+    // No tail padding and no InputFinished calls: only original WAV content.
+    for (int prefix : {0, 12, 45}) {
+      Input input; input.name = "name-prefix" + std::to_string(prefix);
+      Append(&input, clips[0], prefix);
+      runs.push_back(Run(&spotter, {input}, false, true, {320}));
+      std::cerr << "prefix " << prefix << " passed\n";
+    }
+    Input a; a.name = "repeated-name-command-near";
+    Append(&a, clips[0], 12); Append(&a, clips[1], 2); Append(&a, clips[2], 2);
+    Input b; b.name = "independent-near-name-command";
+    Append(&b, clips[2], 0); Append(&b, clips[0], 45); Append(&b, clips[1], 2);
+    for (bool reset : {false, true}) {
+      runs.push_back(Run(&spotter, {a, b}, false, reset, {320, 960}));
+      runs.push_back(Run(&spotter, {a, b}, true, reset, {320, 960}));
+      std::cerr << "repeated and batch reset=" << reset << " passed\n";
+    }
+    std::cout << json({{"status", "passed"}, {"runs", runs},
+                       {"threshold", config.keywords_threshold},
+                       {"keywords_score", config.keywords_score},
+                       {"max_active_paths", config.max_active_paths},
+                       {"num_trailing_blanks", config.num_trailing_blanks},
+                       {"tail_padding_samples", 0}, {"input_finished", false}}).dump(2) << '\n';
+  } catch (const std::exception &e) {
+    std::cerr << "FAILED: " << e.what() << '\n';
+    return 1;
+  }
+}
