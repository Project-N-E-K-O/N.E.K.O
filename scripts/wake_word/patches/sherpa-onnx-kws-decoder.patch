+++ b/sherpa-onnx/csrc/neko-kws-decoder-test.cc
@@ -0,0 +1,168 @@
+#include "sherpa-onnx/csrc/neko-kws-decoder.h"
+
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+
+using namespace sherpa_onnx;  // NOLINT
+
+void Check(bool ok, const char *message) {
+  if (!ok) throw std::runtime_error(message);
+}
+
+template <typename F>
+void MustThrow(F f) {
+  bool caught = false;
+  try { f(); } catch (const std::logic_error &) { caught = true; }
+  Check(caught, "corrupt score state did not fail explicitly");
+}
+
+Hypothesis Make(const ContextState *state, double aggregate, float probability,
+                int32_t time = 2, int32_t blanks = 2) {
+  Hypothesis h({-1, 0, 1, 2}, aggregate, state);
+  h.ys_probs = {probability, probability};
+  h.timestamps = {time, time + 1};
+  h.num_trailing_blanks = blanks;
+  return h;
+}
+
+int main() {
+  try {
+    ContextGraph graph({{1, 2}}, 1.0f, 0.25f, {}, {"wake"});
+    auto *prefix = std::get<1>(graph.ForwardOneStep(graph.Root(), 1));
+    auto *word = std::get<1>(graph.ForwardOneStep(prefix, 2));
+
+    // Direct production helper tests: order independence and whole metadata.
+    for (bool reverse : {false, true}) {
+      auto weak = Make(word, -3, 0.2f, 10, 4);
+      auto strong = Make(word, -2, 0.8f, 20, 2);
+      std::unordered_map<std::string, Hypothesis> merged;
+      neko_kws::PathScores scores;
+      neko_kws::Add(&merged, &scores, reverse ? strong : weak, reverse ? -2 : -3);
+      neko_kws::Add(&merged, &scores, reverse ? weak : strong, reverse ? -3 : -2);
+      auto h = merged.at(strong.Key());
+      Check(std::abs(h.log_prob - std::log(std::exp(-3.) + std::exp(-2.))) < 1e-10,
+            "aggregate score changed");
+      Check(h.ys_probs == strong.ys_probs && h.timestamps == strong.timestamps &&
+            h.num_trailing_blanks == strong.num_trailing_blanks &&
+            h.context_state == strong.context_state, "metadata was mixed");
+      Check(neko_kws::PathScore(scores, h) == -2, "path became aggregate");
+      // A competing path beats the representative, but not its aggregate.
+      auto next = Make(word, -1.8, 0.7f, 30, 3);
+      neko_kws::Add(&merged, &scores, next, -1.8);
+      Check(merged.at(next.Key()).timestamps == next.timestamps,
+            "multi-round merge confused path and aggregate scores");
+    }
+    for (bool reverse : {false, true}) {
+      auto early = Make(word, -2, 0.6f, 4);
+      auto late = Make(word, -2, 0.9f, 8);
+      std::unordered_map<std::string, Hypothesis> merged;
+      neko_kws::PathScores scores;
+      neko_kws::Add(&merged, &scores, reverse ? early : late, -2);
+      neko_kws::Add(&merged, &scores, reverse ? late : early, -2);
+      Check(merged.at(early.Key()).timestamps == early.timestamps,
+            "equal-score tie depends on merge order");
+    }
+
+    // Boundary counterexample: best whole path is not highest keyword mean.
+    auto low_mean = Make(word, -1, 0.2f);
+    auto high_mean = Make(word, -2, 0.9f);
+    std::unordered_map<std::string, Hypothesis> merged;
+    neko_kws::PathScores scores;
+    neko_kws::Add(&merged, &scores, low_mean, -1);
+    neko_kws::Add(&merged, &scores, high_mean, -2);
+    Check(!neko_kws::Eligible(merged.at(low_mean.Key()), graph, 1),
+          "wrongly selected maximum token probabilities");
+
+    // First candidate incomplete, second complete: production selection fixes it.
+    auto valid = Make(word, -2, 0.5f);
+    auto top = Make(prefix, -1, 0.9f);
+    top.ys = {-1, 0, 1};
+    Hypotheses candidates(std::vector<Hypothesis>{top, valid});
+    Check(!neko_kws::Select(candidates, graph, 1, false).hypothesis,
+          "baseline unexpectedly accepts second candidate");
+    auto selected = neko_kws::Select(candidates, graph, 1, true);
+    Check(selected.hypothesis && selected.hypothesis->Key() == valid.Key(),
+          "eligible second candidate was missed");
+    // Invalid candidates cannot bypass confidence / blank / shape checks.
+    for (int fault = 0; fault < 9; ++fault) {
+      auto h = valid;
+      if (fault == 0) h.ys_probs = {0.1f, 0.1f};
+      if (fault == 1) h.num_trailing_blanks = 1;
+      if (fault == 2) h.ys_probs.clear();
+      if (fault == 3) h.timestamps.clear();
+      if (fault == 4) h.ys_probs[0] = std::numeric_limits<float>::quiet_NaN();
+      if (fault == 5) h.timestamps = {4, 3};
+      if (fault == 6) h.timestamps = {-1, 3};
+      if (fault == 7) h.log_prob = std::numeric_limits<double>::infinity();
+      if (fault == 8) h.ys.clear();
+      Check(!neko_kws::Eligible(h, graph, 1), "invalid candidate accepted");
+    }
+    auto other = valid;
+    other.ys.insert(other.ys.begin(), 8);
+    other.log_prob = -1;
+    other.timestamps = {10, 11};
+    Hypotheses two(std::vector<Hypothesis>{valid, other});
+    selected = neko_kws::Select(two, graph, 1, true);
+    Check(selected.hypothesis && selected.hypothesis->timestamps == other.timestamps,
+          "selection did not use highest eligible aggregate or own timestamps");
+    Check(neko_kws::Select(two, graph, 1, false).hypothesis->Key() == other.Key(),
+          "first eligible candidate changed");
+    other.log_prob = valid.log_prob;
+    for (bool reverse : {false, true}) {
+      Hypotheses tied(reverse ? std::vector<Hypothesis>{other, valid} :
+                                std::vector<Hypothesis>{valid, other});
+      Check(neko_kws::Select(tied, graph, 1, true).hypothesis->ys == valid.ys,
+            "candidate tie is not deterministic");
+    }
+
+    // Two independent streams and repeated accepted-hit/stream initialization.
+    Hypotheses stream_a, stream_b;
+    neko_kws::PathScores scores_a, scores_b;
+    neko_kws::Initialize(&stream_a, &scores_a, {-1, 0}, graph.Root());
+    neko_kws::Initialize(&stream_b, &scores_b, {-1, 0}, graph.Root());
+    for (int repeat = 0; repeat < 3; ++repeat) {
+      neko_kws::ValidateScores(stream_a, scores_a);
+      Check(neko_kws::PathScore(scores_a, stream_a.begin()->second) == 0,
+            "empty stream score not zero");
+      scores_a.begin()->second = -20;
+      Check(scores_b.begin()->second == 0, "stream score leakage");
+      neko_kws::Initialize(&stream_a, &scores_a, {-1, 0}, graph.Root());
+      Check(stream_a.Size() == 1 && scores_a.size() == 1, "reset leaked state");
+    }
+    scores_a.clear();
+    MustThrow([&] { neko_kws::PathScore(scores_a, stream_a.begin()->second); });
+    MustThrow([&] { neko_kws::ValidateScores(stream_a, scores_a); });
+    scores_a.emplace("orphan", 0);
+    MustThrow([&] { neko_kws::ValidateScores(stream_a, scores_a); });
+    // Returning to context root forgets tokens, but is not a new stream:
+    // preserve the complete path score rather than silently reseeding zero.
+    Hypothesis root_path({-1, 0}, -12, graph.Root());
+    merged.clear(); scores.clear();
+    neko_kws::Add(&merged, &scores, root_path, -15);
+    Check(neko_kws::PathScore(scores, root_path) == -15,
+          "context-root transition reseeded the path score");
+    // Per-frame next maps contain only survivors; no historical scores leak.
+    for (int frame = 0; frame < 20; ++frame) {
+      std::unordered_map<std::string, Hypothesis> next;
+      neko_kws::PathScores next_scores;
+      auto survivor = merged.begin()->second;
+      neko_kws::Add(&next, &next_scores, survivor,
+                    neko_kws::PathScore(scores, survivor) - 0.1);
+      merged = std::move(next);
+      scores = std::move(next_scores);
+      Check(merged.size() == 1 && scores.size() == 1,
+            "next-frame score storage grew with history");
+    }
+    // Preserve the currently shipped prefix-probability policy explicitly.
+    auto prefix_probability = valid;
+    prefix_probability.ys_probs = {0.1f, 0.1f, 0.9f, 0.9f};
+    Check(!neko_kws::Eligible(prefix_probability, graph, 1),
+          "this change silently switched prefix probabilities to suffix");
+    std::cout << "KWS production helper regressions passed\n";
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+  return 0;
+}
