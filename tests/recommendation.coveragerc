# Run from the repository root with --cov (without dotted module arguments).
# Dotted sources let coverage import router packages before conftest installs
# storage isolation, then leave stale package attributes when imports are reset.
[run]
include =
    main_logic/recommendation_feedback.py
    main_routers/proactive_feedback_router.py
    main_routers/recommendation_router.py
    services/proactive_feedback/capture.py
    services/proactive_feedback/protocol.py
    services/proactive_feedback/runtime.py
    services/proactive_feedback/runtime_v2.py
    utils/preferences.py
    utils/preferences_audit.py

[report]
fail_under = 80
show_missing = True
skip_covered = True
