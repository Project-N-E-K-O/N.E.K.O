{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-neko.example/schemas/motion-action-card.json",
  "title": "N.E.K.O 中文动作卡",
  "description": "中文动作含义是唯一权威语义；多语言文本先在运行时规范化为中文动作帧。文件可改名，stableId 不得变化。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stableId",
    "intent",
    "kind",
    "nameZh",
    "positiveZh",
    "negativeZh",
    "styles",
    "body",
    "emotions",
    "default",
    "inputPose",
    "resultPose",
    "playback",
    "descriptionStatus"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,63}$"
    },
    "intent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
    },
    "kind": {
      "enum": ["pose", "gesture", "emotion-body", "activity", "control", "rest"]
    },
    "nameZh": {
      "type": "string",
      "minLength": 4,
      "maxLength": 32,
      "description": "像‘盘着腿坐’、‘害羞地把双手背在身后’一样直接描述画面。"
    },
    "positiveZh": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 24 }
    },
    "negativeZh": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 24 }
    },
    "styles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$" }
    },
    "body": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["头", "脸", "目光", "肩", "身体", "胸", "腰", "手", "双手", "手掌", "手指", "手臂", "腿", "膝", "脚"]
      }
    },
    "emotions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["neutral", "happy", "sad", "angry", "shy", "surprise"] }
    },
    "default": { "type": "boolean" },
    "inputPose": { "enum": ["stand", "sit", "lie", "sleep"] },
    "resultPose": { "enum": ["stand", "sit", "lie", "sleep"] },
    "playback": { "enum": ["once", "loop", "hold", "move", "speech"] },
    "descriptionStatus": {
      "enum": ["provisional-local-review", "human-verified", "maintainer-approved"]
    }
  }
}
