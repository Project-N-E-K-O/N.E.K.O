{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LifeKit: test",
      "type": "shell",
      "command": "uv run pytest -q plugin/plugins/lifekit/tests",
      "options": {
        "cwd": "${workspaceFolder}/../../.."
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "LifeKit: release check",
      "type": "shell",
      "command": "uv run python neko_plugin_cli/cli.py check lifekit --release",
      "options": {
        "cwd": "${workspaceFolder}/../.."
      },
      "problemMatcher": []
    }
  ]
}
