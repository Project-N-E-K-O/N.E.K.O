{
  "build_env": {
    "arch": "arm64",
    "os": "darwin",
    "python": "3.11"
  },
  "entries": [
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.clear.description",
        "default": "删除网易云音乐插件私有数据目录中保存的 Cookie。"
      },
      "event_key": "netease_music.clear_music_u",
      "event_type": "plugin_entry",
      "id": "clear_music_u",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "ui_token": {
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "ui_token"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_schema": {},
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.clear.name",
        "default": "清除网易云凭据"
      },
      "return_message": "",
      "timeout": null
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.play.description",
        "default": "仅在用户明确要求播放或点播某首网易云歌曲时调用。将 query 整理为“歌名 歌手”，保留现场版、翻唱等版本限定。不要用于歌词或歌曲知识查询、泛推荐、歌单、暂停、停止、切歌或下一首。"
      },
      "event_key": "netease_music.play_netease_music",
      "event_type": "plugin_entry",
      "id": "play_netease_music",
      "input_schema": {
        "additionalProperties": false,
        "description": "Public plugin-entry request.  The model never accepts delivery details.",
        "properties": {
          "query": {
            "description": {
              "$i18n": "entry.play.param.query",
              "default": "歌曲名，可附带歌手或版本"
            },
            "maxLength": 100,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "PlayRequest",
        "type": "object"
      },
      "kind": "action",
      "llm_result_schema": {},
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.play.name",
        "default": "播放网易云歌曲"
      },
      "return_message": "",
      "timeout": 20.0
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.playlist.description",
        "default": "放点歌、陪伴连播默认 curate：结合聊天和音乐偏好记忆选 6 至 8 首，tracks 为字符串数组，每项「歌名 | 歌手」。搜网易云现成歌单用 search，name 传关键词。revise 按新偏好替换尚未播放的曲目，不打断当前歌；save_current 将此刻播放器确认的一首追加到指定本地歌单，自动去重；仅在明确保存整张播放队列时用 save；replay 重放“我们自己的本地歌单”或已收藏的 name；list 列出收藏；next 下一首；stop 停止。"
      },
      "event_key": "netease_music.playlist",
      "event_type": "plugin_entry",
      "id": "playlist",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "curate",
              "revise",
              "search",
              "save_current",
              "save",
              "replay",
              "list",
              "next",
              "stop"
            ],
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "type": "string"
          },
          "name_confirmed": {
            "type": "boolean"
          },
          "tracks": {
            "items": {
              "maxLength": 150,
              "type": "string"
            },
            "maxItems": 24,
            "type": "array"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_schema": {},
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "playlist.title",
        "default": "网易云歌单连播与收藏"
      },
      "return_message": "",
      "timeout": 90
    },
    {
      "auto_start": false,
      "description": "",
      "event_key": "netease_music.playlist_terminal",
      "event_type": "plugin_entry",
      "id": "playlist_terminal",
      "input_schema": {
        "properties": {
          "reason": {
            "type": "string"
          },
          "ticket": {
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "reason"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_schema": {},
      "metadata": {
        "agent_hidden": true
      },
      "model_validate": true,
      "name": "播放器队列回执",
      "return_message": "",
      "timeout": 90
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.save.description",
        "default": "将网易云 Cookie 白名单字段加密保存到插件私有数据目录。"
      },
      "event_key": "netease_music.save_music_u",
      "event_type": "plugin_entry",
      "id": "save_music_u",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "music_u": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          },
          "nmtid": {
            "maxLength": 4096,
            "type": "string",
            "writeOnly": true
          },
          "ui_token": {
            "minLength": 1,
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "music_u",
          "ui_token"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_schema": {},
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.save.name",
        "default": "保存网易云凭据"
      },
      "return_message": "",
      "timeout": null
    }
  ],
